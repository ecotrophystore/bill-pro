rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active == true
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isAccounts() {
      return getUserRole() == 'accounts';
    }
    
    function isSales() {
      return getUserRole() == 'sales';
    }

    function isHR() {
      return getUserRole() == 'hr';
    }

    function isStandardUser() {
      return getUserRole() == 'user';
    }
    
    function isUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }
    
    function isLocked() {
      return resource != null && resource.data.is_locked == true;
    }

    // Role Isolation: Strict Firestore security rules
    
    // USER INVITES (keyed by lowercase email for cryptographic role assignment on signup)
    match /user_invites/{inviteEmail} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (isHR() && request.resource.data.role != 'admin');
      allow delete: if isAdmin() || (isHR() && resource.data.role != 'admin') || (isAuthenticated() && request.auth.token.email == inviteEmail);
    }

    // USERS COLLECTION
    // Users can read profiles; self-signup defaults to 'user' unless a valid invite exists in user_invites; Admin manages all; HR manages non-admin roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        || (isHR() && request.resource.data.role != 'admin')
        || (isAuthenticated() && request.auth.uid == userId && (
              request.resource.data.role == 'user'
              || (
                request.auth.token.email != null
                && exists(/databases/$(database)/documents/user_invites/$(request.auth.token.email))
                && get(/databases/$(database)/documents/user_invites/$(request.auth.token.email)).data.role == request.resource.data.role
              )
           ));
      allow update: if isAdmin() || (isHR() && resource.data.role != 'admin' && request.resource.data.role != 'admin');
      allow delete: if isAdmin();

      match /ai_conversations/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    // CUSTOMERS COLLECTION
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAccounts() || isSales();
      allow delete: if isAdmin() || isAccounts();
    }
    
    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAccounts() || isSales();
      allow delete: if isAdmin();
    }
    
    // SETTINGS COLLECTION
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }
    
    // QUOTATIONS COLLECTION
    match /quotations/{quotationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAccounts() || isSales() || isStandardUser();
      allow delete: if isAdmin() || isAccounts();
    }
    
    // INVOICES COLLECTION
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAccounts() || isSales();
      allow update: if (isAdmin() || isAccounts()) && (
        !isLocked()
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'manual_paid_amount',
             'reconciled_bank_amount',
             'paid_amount',
             'balance_amount',
             'payment_status',
             'status',
             'updated_at'
           ])
      );
      allow delete: if isAdmin();
    }
    
    // PROFORMA INVOICES COLLECTION
    match /proforma_invoices/{proformaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAccounts() || isSales();
      allow delete: if isAdmin() || isAccounts();
    }
    
    // CASH MEMOS COLLECTION
    match /cash_memos/{memoId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAccounts() || isSales() || isStandardUser();
      allow delete: if isAdmin() || isAccounts();
    }
    
    // PURCHASES COLLECTION
    match /purchases/{purchaseId} {
      allow read: if isAdmin() || isAccounts() || isSales() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || isAccounts() || isSales();
      allow update: if isAdmin() || isAccounts() || isSales();
      allow delete: if isAdmin();
    }

    // EXPENSES COLLECTION
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAccounts() || isSales() || isHR() || isStandardUser();
      allow delete: if isAdmin() || isHR();
    }

    // PURCHASE ATTACHMENTS
    match /purchase_attachments/{docId} {
      allow read: if isAdmin() || isAccounts() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // AI LEARNING FEEDBACK
    match /ai_learning_feedback/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // AI EXTRACTION LOGS
    match /ai_extraction_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // PURCHASE ACTIVITY LOGS
    match /purchase_activity_logs/{docId} {
      allow read: if isAdmin() || isAccounts() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // PAYMENTS COLLECTION
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounts() || isSales();
    }

    // TRANSACTIONS COLLECTION (Bank Recon)
    match /transactions/{transactionId} {
      allow read: if isAdmin() || isAccounts() || isSales();
      allow create: if isAdmin() || isAccounts() || isSales();
      allow update, delete: if isAdmin() || isAccounts();
    }
    
    // STATEMENT LOGS (Bank Recon)
    match /statement_logs/{logId} {
      allow read: if isAdmin() || isAccounts();
      allow create, update, delete: if isAdmin() || isAccounts();
    }

    // RECONCILIATION SETTINGS & MONTHLY REPORT LOGS (Admin & Accounts)
    match /reconciliation_settings/{docId} {
      allow read, write: if isAdmin() || isAccounts();
    }

    match /reconciliation_report_logs/{monthKey} {
      allow read, write: if isAdmin() || isAccounts();
    }
    
    // REPORTS & NOTIFICATIONS
    match /reports/{reportId} { allow read: if isAuthenticated(); }
    match /notifications/{notifId} { 
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAccounts();
      allow update: if isAuthenticated(); // for marking read
      allow delete: if isAuthenticated();
    }

    // SYSTEM CONFIG COLLECTION
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // META INTEGRATION CONFIG
    match /meta_integrations/{docId} {
      allow read: if isAuthenticated(); // All authenticated users can see connection status
      allow write: if isAdmin(); // Only Admins can save API secrets/config
    }
    
    match /leads/{leadId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.owner_id == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        )
      );
      allow create: if isAdmin() || isAccounts() || isSales();
      allow update: if isAdmin() || (
        (isAccounts() || isSales()) &&
        (resource.data.owner_id == request.auth.uid || resource.data.ownerId == request.auth.uid) &&
        isUnchanged('owner_id') &&
        isUnchanged('ownerId') &&
        isUnchanged('sales_person')
      );
      allow delete: if isAdmin() || (
        (isSales() || isAccounts()) &&
        (resource.data.owner_id == request.auth.uid || resource.data.ownerId == request.auth.uid)
      );
    }

    match /lead_assignment/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /pipelines/{pipelineId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounts() || isSales();
    }

    match /stage_messages/{stageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounts() || isSales();
    }

    match /lead_notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    match /conversations/{convId} {
      allow read, write: if isAuthenticated();
    }

    match /message_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounts() || isSales();
    }

    match /message_queue/{queueId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAccounts() || isSales();
      allow update: if isAdmin(); // only Admin (Cloud Functions) can update status/delivery parameters
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounts() || isSales();
    }

    match /whatsapp_automations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSales();
    }

    match /whatsapp_welcome_kit/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounts() || isSales();
    }

    match /automation_enrollments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSales();
      allow update: if isAdmin(); // only Cloud Functions can update scheduler status
      allow delete: if isAdmin();
    }

    match /lead_intake_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // META WEBHOOK EVENTS
    match /meta_webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions write to this
    }
    
    // AUDIT LOG
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isAccounts() || isHR();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
  }
}



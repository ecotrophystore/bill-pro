# ==============================================================================
# EcoBill Cloud Functions - Secret Configuration Template
# ==============================================================================
# Copy this file to `functions/.secret.local` for local emulator testing.
# For production deployment, set each secret via Firebase CLI:
#   firebase functions:secrets:set <SECRET_NAME>
# ==============================================================================

# 1. Google Gemini API Key (Required for AI Auditor, Receipt OCR, Voice Dictation, Bank Recon)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=

# 2. Meta WhatsApp Access Token (Permanent / System User Token with whatsapp_business_messaging permission)
# Get from: Meta Business Suite -> Settings -> System Users -> Generate Token
META_WHATSAPP_ACCESS_TOKEN=

# 3. Meta Facebook System User Token (System User Token with pages_show_list, leads_retrieval permissions)
# Get from: Meta Business Suite -> Settings -> System Users -> Generate Token
META_FACEBOOK_SYSTEM_USER_TOKEN=

# 4. Meta App Secret (Used to verify HMAC SHA-256 signatures of inbound webhooks)
# Get from: https://developers.facebook.com/ -> Your App -> App Settings -> Basic -> App Secret
META_APP_SECRET=

# 5. Meta Webhook Verify Token (Custom verification string for GET webhook challenge handshake)
# Value: Set any secure string (e.g. ecotrophy_billpro_verify_2026_eco) and enter the same in Meta Dashboard
META_WEBHOOK_VERIFY_TOKEN=ecotrophy_billpro_verify_2026_eco

# 6. Google Lead Webhook Secret (Custom authentication key for Google Ads lead form extensions)
# Value: Set any secure string and match it in Google Ads webhook lead configuration
GOOGLE_WEBHOOK_KEY=
